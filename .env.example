# ==============================================================================
# Planora Environment Variables Configuration
# ==============================================================================

# 1. AI Engine API Key (Recommended: OpenRouter Gemini 2.5 Flash)
# When deploying to Vercel, add this in:
# Project Settings -> Environment Variables -> Key: VITE_OPENROUTER_API_KEY
# Note: You can also use Google Gemini API Key directly via VITE_GEMINI_API_KEY.
VITE_OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# Optional: Direct Google Gemini API Key from Google AI Studio
# VITE_GEMINI_API_KEY=AIzaSy...

# 2. Cloud Sync & Hybrid Database (Option C - Neon PostgreSQL / Supabase)
# When deploying to Vercel, add your Neon PostgreSQL database URL:
# Project Settings -> Environment Variables -> Key: VITE_DATABASE_URL
VITE_DATABASE_URL=postgresql://neondb_owner:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require

# Also provide DATABASE_URL for standard backend / ORM tools if needed:
# DATABASE_URL=postgresql://neondb_owner:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require
