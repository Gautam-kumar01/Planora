# ==============================================================================
# Planora Environment Variables Configuration
# ==============================================================================

# 1. AI Engine API Key (Recommended: OpenRouter Gemini 2.5 Flash)
# When deploying to Vercel, add this in:
# Project Settings -> Environment Variables -> Key: VITE_OPENROUTER_API_KEY
# Note: You can also use Google Gemini API Key directly via VITE_GEMINI_API_KEY.
VITE_OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# Optional: Direct Google Gemini API Key from Google AI Studio
# VITE_GEMINI_API_KEY=AIzaSy...

# 2. Cloud Sync & Hybrid Database (Option C - Optional)
# If you want real-time cross-device sync via Supabase:
# VITE_DATABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
